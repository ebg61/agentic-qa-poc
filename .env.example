# LLM (OpenAI-compatible Responses API)
LLM_API_KEY=your_llm_api_key_here
# Optional. Defaults to https://api.openai.com/v1
# LLM_BASE_URL=https://api.openai.com/v1
# Optional. Defaults to gpt-5-mini
# LLM_MODEL=gpt-5-mini

# Taiga
TAIGA_BASE_URL=https://api.taiga.io
TAIGA_USERNAME=your_taiga_username_here
TAIGA_PASSWORD=your_taiga_password_here
TAIGA_PROJECT_SLUG=erikatest-poc
# Optional temporary fallback if username/password are not used
# TAIGA_TOKEN=your_taiga_token_here
# Optional. Defaults to Bearer
# TAIGA_AUTH_SCHEME=Bearer

# Optional Playwright application URL override
# HOMEPAGE=https://www.groupon.com/
# BASE_URL=https://www.groupon.com/

# Optional QA Review UI port. Defaults to 3000
# PORT=3000
